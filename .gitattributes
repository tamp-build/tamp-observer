# Normalize line endings. The repo stores LF; builds run on Linux pods and must be
# deterministic. Working copies on Windows can still check out CRLF via core.autocrlf.
* text=auto eol=lf

# Scripts that must keep a specific ending regardless of platform.
*.sh    text eol=lf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Known binaries (don't touch).
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.pdf   binary

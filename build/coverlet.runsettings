<?xml version="1.0" encoding="utf-8"?>
<!-- Coverlet collector config: emit OpenCover XML, which SonarCloud's .NET path
     (sonar.cs.opencover.reportsPaths) consumes. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

  "components": {
    "schemas": {
      "AlertEventView": {
        "required": [
          "kind",
          "issueId",
          "title",
          "atUtc"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "issueId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "atUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AlertRuleView": {
        "required": [
          "id",
          "name",
          "enabled"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "AlertsView": {
        "required": [
          "rules",
          "history"
        ],
        "type": "object",
        "properties": {
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlertRuleView"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlertEventView"
            }
          }
        }
      },
      "AllowUserRequest": {
        "required": [
          "email",
          "role"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ChannelView": {
        "required": [
          "type",
          "reachback",
          "allowedUnderMode"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "reachback": {
            "type": "boolean"
          },
          "allowedUnderMode": {
            "type": "boolean"
          }
        }
      },
      "ClientEvent": {
        "required": [
          "kind",
          "level",
          "message",
          "url",
          "status",
          "stack",
          "atUnixMs"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": [
              "null",
              "string"
            ]
          },
          "level": {
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": "string"
          },
          "url": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "stack": {
            "type": [
              "null",
              "string"
            ]
          },
          "atUnixMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "ClientTelemetryRequest": {
        "required": [
          "sessionId",
          "userAgent",
          "events"
        ],
        "type": "object",
        "properties": {
          "sessionId": {
            "type": [
              "null",
              "string"
            ]
          },
          "userAgent": {
            "type": [
              "null",
              "string"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientEvent"
            }
          }
        }
      },
      "EnforcementView": {
        "required": [
          "mode",
          "locked"
        ],
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "locked": {
            "type": "boolean"
          }
        }
      },
      "IngestedLog": {
        "required": [
          "receiptId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "serviceId": {
            "type": "string",
            "format": "uuid"
          },
          "environmentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "timeUnixNano": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "severityNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "severityText": {
            "type": [
              "null",
              "string"
            ]
          },
          "body": {
            "type": [
              "null",
              "string"
            ]
          },
          "traceId": {
            "type": [
              "null",
              "string"
            ]
          },
          "spanId": {
            "type": [
              "null",
              "string"
            ]
          },
          "instanceId": {
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "receiptId": {
            "type": "string"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"

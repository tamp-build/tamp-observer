<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Storage (ADR 0005 / 0006: Postgres+Marten baseline)">
    <PackageVersion Include="Marten" Version="9.44.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Build (dogfood the tamp ecosystem, rule #3)">
    <PackageVersion Include="Tamp.Core" Version="1.17.3" />
    <PackageVersion Include="Tamp.NetCli.V10" Version="1.17.3" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

</Project>

<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Storage (ADR 0005 / 0006: Postgres+Marten baseline)">
    <PackageVersion Include="Marten" Version="9.44.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="ClickHouse top tier (ADR 0005 opt-in analytical tier)">
    <PackageVersion Include="ClickHouse.Client" Version="7.14.0" />
    <PackageVersion Include="Testcontainers.ClickHouse" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup Label="Raw-bucket Valkey high tier (ADR 0004 section 2)">
    <PackageVersion Include="StackExchange.Redis" Version="3.3.1" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup Label="DuckDB on-demand analytical accelerator (ADR 0005 middle tier)">
    <PackageVersion Include="DuckDB.NET.Data.Full" Version="1.5.6" />
  </ItemGroup>

  <ItemGroup Label="Evaluator (ADR 0004: consumes the spool, resolves entities)">
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Build (dogfood the tamp ecosystem, rule #3)">
    <PackageVersion Include="Tamp.Core" Version="1.17.3" />
    <PackageVersion Include="Tamp.NetCli.V10" Version="1.17.3" />
    <PackageVersion Include="Tamp.Go" Version="0.1.0" />
    <PackageVersion Include="Tamp.SonarScanner.V10" Version="0.3.2" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

</Project>
